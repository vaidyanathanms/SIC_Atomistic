#####################################################
# Stage 3: Equilibrium NVT Run Using Nose-Hoover    #
# Version: Sept-03-2026                             #
# Uses fix wall/lj and p p f             	    #
#####################################################

# Initialization
units		real
boundary	p p f 
atom_style	full
read_restart	restart.lang

# Neighbor information
neighbor        3.0 bin
neigh_modify	every 10 one 10000

# Pair Information
pair_style      lj/cut/coul/long 8.0 15.0
include         pair_coeff.dat
pair_modify     shift yes mix geometric

# Topology Information
bond_style      harmonic
special_bonds   lj/coul 0.0 0.0 0.5
include         bond_coeff.dat

angle_style     harmonic
include         angle_coeff.dat

dihedral_style  opls
include         dihed_coeff.dat

improper_style  none

# Electrostatic Information
kspace_style    pppm 0.00001
kspace_modify   slab 3.0
dielectric      1

# Define Groups
group sei_peo type 2:4
group vec_mtfsi type 9:22
group polymer union sei_peo vec_mtfsi
group coi_ions type 6:8
group li_ions type 5

#####################################################
# Equilibration (Nose-Hoover dynamics at 300K)
#####################################################

# Initiate/Write Atoms and Other Details
variable        ts equal step
thermo_style	custom step temp etotal
thermo          100000
dump            main all custom 5000 config_nvtequil.lammpstrj id type xu yu zu
dump_modify     main append yes

# Main Fixes - Switch back to NVT
fix  fast polymer shake 0.0001 30 5000000 b 2 10 14
fix  integrate all nvt temp 300.0 300.0 100.0
fix  wallhi   all wall/lj126 zhi  EDGE 0.5 0.5 0.56123
fix  walllow  all wall/lj126 zlo  EDGE 0.5 0.5 0.56123

# Run and Restart Styles
run_style verlet
restart   500000 restart1 restart2
restart   10000000 archival_restarts/archival_*.restart

timestep  1.0
run  2000000 

timestep  2.0
run  2000000

# Unfix
unfix fast
unfix integrate
unfix wallhi
unfix walllow

# Write Outputs
write_data      nvtequil.data pair ij
write_restart 	restart.nvtequil
