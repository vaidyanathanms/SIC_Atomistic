#####################################################
# Stage 3: Main Run Using Nose-Hoover               #
# Version: Mar-18-2026                              #
#####################################################


# Initialization
units		real
boundary	p p f
atom_style	full
read_restart    restart1
#read_restart	archive_restarts/archival_*.restart

# Neighbor information
neighbor        3.0 bin
neigh_modify	every 1 one 20000 page 200000

# Pair Information
pair_style      lj/cut/coul/long 8.0 15.0
include         pair_coeff.dat
pair_modify     shift yes mix geometric

# Topology Information
bond_style      harmonic
special_bonds   lj/coul 0.0 0.0 0.5
include         bond_coeff.dat

angle_style     harmonic
include         angle_coeff.dat

dihedral_style  opls
include         dihed_coeff.dat

improper_style  none

# Electrostatic Information
kspace_style    pppm 0.00001
kspace_modify   slab 3.0
dielectric      1

write_data      lmp_nvt.data
# Define Groups
group li_surface type 1
group sei_peo type 2:4
group vec_mtfsi type 9:22
group polymer union sei_peo vec_mtfsi
group coi_ions type 6:8
group li_ions type 5

# Define variables based on Li-diameter
variable z0 equal 0.005
variable z1 equal 2.4
variable z2 equal 4.8
variable z3 equal 7.2
variable z4 equal 9.6

# Define regions
region rlayer1 block INF INF INF INF ${z0} ${z1} units box
region rlayer2 block INF INF INF INF ${z1} ${z2} units box
region rlayer3 block INF INF INF INF ${z2} ${z3} units box
region rlayer4 block INF INF INF INF ${z3} ${z4} units box

# Group into bottom two layers (freeze), 3rd (spring/self) and mobile 4th
group glayer1 region rlayer1
group glayer2 region rlayer2
group glayer3 region rlayer3
group glayer4 region rlayer4

group li_layer1 intersect glayer1 li_surface
group li_layer2 intersect glayer2 li_surface

group li_bottom union li_layer1 li_layer2
group li_midlayer intersect glayer3 li_surface
group li_toplayer intersect glayer4 li_surface

# Define mobile groups (except bottom two)
group mobile subtract all li_bottom


#####################################################
# Equilibration (Nose-Hoover dynamics at 300K)
#####################################################

# Initiate/Write Atoms and Other Details
variable        ts equal step
thermo_style	custom step temp pe
thermo          1000000
dump            main all custom 5000 config_prod.lammpstrj id type xu yu zu
dump_modify     main append yes

# Main Fixes
fix  wallhi   all wall/lj126 zhi  EDGE 0.5 0.5 0.56123
fix  walllow  all wall/lj126 zlo  EDGE 0.5 0.5 0.56123
fix  freeze li_bottom setforce 0.0 0.0 0.0 # Freeze bottom two layers
fix  tether li_midlayer spring/self 3.0 # Spring-self to mid-layer
fix  fast polymer shake 0.0001 30 1000000 b 2 10 14 # fix shake for C-H bonds
fix  mom mobile momentum 1000000 linear 1 1 1 rescale 
fix  integrate mobile nvt temp 300.0 300.0 100.0 # integrate all except bottom

# Run Styles
run_style verlet
restart   5000 restart1 restart2
restart   500000 archive_restarts/archival_*.restart
 
#timestep  0.5
#run  15000000 

timestep  1.0
run  25000000 upto

timestep  2.0
run  50000000 upto
unfix shake
unfix freeze
unfix tether
unfix integrate
write_data      nvt.dat pair ij
write_restart 	restart.nvt
