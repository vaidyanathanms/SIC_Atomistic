# Cross check with the excel file for dimensions
# Name of the excel file: InputCalculations/input_structure.xlsx

tolerance 2.0
filetype pdb
output li_co32m_peo_vecmtfsi_fan_0pt156.pdb
movebadrandom

################### Lithium surface layer ##############################
# Lithium (fixed)
structure /home/vaidyams/all_codes/files_interface/InputStructures/inpcoord_files/li_surface/lithium_large_edited.pdb
  number 1
  fixed 0. 0. 0. 0. 0. 0.
end structure

################### SEI layer ##########################################
# x_min = 0;  y_min = 0;  z_min_SEI = max-z of Li-surface + \delta_z
# x_max = lx; y_max = ly; z_max_SEI = z-of-SEI + z_min
# z-of-SEI is an input: For 6 layers it is 12.31 A. Give a small delta_z
# See columns U, Q and R of the excel file for #of PEO/Li+/CO32-
# See columns N and O  for X/Y and P for Z dimentions. 
# Add a small epsilon in X/Y (~0.05A) and Z (~1A).

# PEO layer
structure /home/vaidyams/all_codes/files_interface/InputStructures/inpcoord_files/peo_polymer/60PEO_Optimized_CH3terminated_editedterminal_edited.pdb
  number 34 
  inside box -0.05 -0.05 13.0  83.5776 83.72257 43.0 # 6 layer height is 12.31 A 
end structure

# Li atoms inside PEO layer
structure /home/vaidyams/all_codes/files_interface/InputStructures/inpcoord_files/li_monomer/Li_Atom_edited.pdb
  number 833
  inside box -0.05 -0.05 13.0  83.5776 83.72257 43.0
end structure

# counter-ions carbonate molecules inside PEO layer (half of lithium)
structure /home/vaidyams/all_codes/files_interface/InputStructures/inpcoord_files/co32m_monomer/co3_2minus_edited.pdb
  number 1666 
  inside box -0.05 -0.05 13.0  83.5776 83.72257 43.0
end structure


################### Bulk layer #########################################
# x_min = 0;  y_min = 0;  z_min_bulk = z_max_SEI - delta_z
# x_max = lx; y_max = ly; z_max_bulk = z_max_SEI + lz_bulk
# Use -delta_z for zmin_bulk to blend the SEI with the bulk
# Zhi should be the point where there is wall b/c: Column AG
# See columns H and I for #of VEC-MTFSI/Li+
# See columns AH for Z-dimension - this is different from where the wall is!

# VEC-STFSI Polymer: 120 molecules. Bigger gap near the wall and smaller near the interface
structure /home/vaidyams/all_codes/files_interface/InputStructures/inpcoord_files/vecmtfsi_polymer/V27M5_150T_edited.pdb
  number 120
  inside box 0. 0. 44.0  83.5776 83.72257 150.0 # Zhi should be the point where there is wall b/c
end structure

# Li atoms: 600. Leave a bigger gap near the wall and near the interface
structure /home/vaidyams/all_codes/files_interface/InputStructures/inpcoord_files/li_atom/Li_Atom.pdb
  number 600
  inside box 0. 0. 44.0  83.5776 83.72257 150.0
end structure

